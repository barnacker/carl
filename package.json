{
  "name": "carl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CARL Stage 0 executable spine prototype.",
  "bin": {
    "carl": "./bin/carl.js",
    "carltest": "./bin/carltest.js",
    "carl-web": "./bin/carl-web.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "carl": "node bin/carl.js",
    "carl-web": "node bin/carl-web.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/**/*.test.js tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
